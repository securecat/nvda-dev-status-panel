#. Translators: Name of the IME NonConvert key (無変換) used as an NVDA modifier
#. key.
#: addon/globalPlugins/devStatusPanel/__init__.py:105
msgid "NonConvert"
msgstr "無変換"

#. Translators: Name of the IME Convert key (変換) used as an NVDA modifier key.
#: addon/globalPlugins/devStatusPanel/__init__.py:108
msgid "Convert"
msgstr "変換"

#. Translators: Name of the Escape key used as an NVDA modifier key.
#: addon/globalPlugins/devStatusPanel/__init__.py:111
msgid "Escape"
msgstr "Escape"

#. Translators: Name of the Insert key used as an NVDA modifier key.
#: addon/globalPlugins/devStatusPanel/__init__.py:115
msgid "Insert"
msgstr "Insert"

#. Translators: Name of the numpad Insert key used as an NVDA modifier key.
#: addon/globalPlugins/devStatusPanel/__init__.py:118
msgid "Numpad Insert"
msgstr "テンキーInsert"

#. Translators: Name of the CapsLock key used as an NVDA modifier key.
#: addon/globalPlugins/devStatusPanel/__init__.py:121
msgid "CapsLock"
msgstr "CapsLock"

#. Translators: Mode shown when the focused object has no tree interceptor.
#: addon/globalPlugins/devStatusPanel/__init__.py:156
msgid "Normal (browse mode not applicable)"
msgstr "通常操作（ブラウズモード対象外）"

#. Translators: Virtual buffer status shown when there is no virtual buffer.
#: addon/globalPlugins/devStatusPanel/__init__.py:158
msgid "None"
msgstr "なし"

#. Translators: Name of NVDA's focus mode / browse mode.
#: addon/globalPlugins/devStatusPanel/__init__.py:161
msgid "Focus mode"
msgstr "フォーカスモード"

#: addon/globalPlugins/devStatusPanel/__init__.py:161
msgid "Browse mode"
msgstr "ブラウズモード"

#. Translators: Virtual buffer load state (ready / still loading).
#: addon/globalPlugins/devStatusPanel/__init__.py:164
msgid "ready"
msgstr "準備完了"

#: addon/globalPlugins/devStatusPanel/__init__.py:164
msgid "loading…"
msgstr "読み込み中…"

#. Translators: Virtual buffer load state when it cannot be determined.
#: addon/globalPlugins/devStatusPanel/__init__.py:167
msgid "unknown"
msgstr "状態不明"

#. Translators: Virtual buffer status. {state} is the load state, {cls} is the
#. class name (e.g. Chromium).
#: addon/globalPlugins/devStatusPanel/__init__.py:169
msgid "Present ({state} / {cls})"
msgstr "あり（{state} / {cls}）"

#. Translators: Mode shown when the tree interceptor does not support browse
#. mode.
#: addon/globalPlugins/devStatusPanel/__init__.py:172
msgid "TreeInterceptor without browse mode support"
msgstr "ブラウズモード非対応のTreeInterceptor"

#. Translators: Virtual buffer status. {cls} is the class name of the tree
#. interceptor.
#: addon/globalPlugins/devStatusPanel/__init__.py:174
msgid "Present ({cls})"
msgstr "あり（{cls}）"

#. Translators: Shown when the focused object has no name.
#: addon/globalPlugins/devStatusPanel/__init__.py:178
msgid "(no name)"
msgstr "（名前なし）"

#. Translators: Focused object info. {name}, {role} and {states} come from
#. NVDA.
#: addon/globalPlugins/devStatusPanel/__init__.py:183
msgid "{name} / {role} ({states})"
msgstr "{name} ／ {role}（{states}）"

#. Translators: Focused object info without states.
#: addon/globalPlugins/devStatusPanel/__init__.py:186
msgid "{name} / {role}"
msgstr "{name} ／ {role}"

#: addon/globalPlugins/devStatusPanel/__init__.py:209
msgid "NVDA Developer Status Panel"
msgstr "NVDA 開発者ステータスパネル"

#. Translators: Row labels in the panel.
#: addon/globalPlugins/devStatusPanel/__init__.py:221
msgid "Mode:"
msgstr "モード:"

#: addon/globalPlugins/devStatusPanel/__init__.py:222
msgid "Virtual buffer:"
msgstr "仮想バッファ:"

#: addon/globalPlugins/devStatusPanel/__init__.py:223
msgid "Focus:"
msgstr "フォーカス:"

#: addon/globalPlugins/devStatusPanel/__init__.py:224
msgid "App:"
msgstr "アプリ:"

#: addon/globalPlugins/devStatusPanel/__init__.py:225
msgid "NVDA key:"
msgstr "NVDA制御キー:"

#. Translators: Checkbox label.
#: addon/globalPlugins/devStatusPanel/__init__.py:238
msgid "Enable monitoring"
msgstr "監視を有効にする"

#. Translators: Checkbox label.
#: addon/globalPlugins/devStatusPanel/__init__.py:242
msgid "Keep this panel on top"
msgstr "このパネルを最前面に表示"

#. Translators: Note shown while the panel itself has focus.
#: addon/globalPlugins/devStatusPanel/__init__.py:435
msgid ""
"Note: Showing the state of the previous app because the panel is in use."
msgstr "※パネル操作中のため、直前のアプリの状態を表示しています。"

#. Translators: Button label shown in two lines. {key} is the actual key, e.g.
#. NonConvert+Space.
#: addon/globalPlugins/devStatusPanel/__init__.py:438
msgid ""
"Toggle mode\n"
"({key})"
msgstr ""
"モード切替\n"
"({key})"

#. Translators: Button label shown in two lines. {key} is the actual key, e.g.
#. NonConvert+F5.
#: addon/globalPlugins/devStatusPanel/__init__.py:440
msgid ""
"Refresh virtual buffer\n"
"({key})"
msgstr ""
"仮想バッファ再読み込み\n"
"({key})"

#. Translators: Shown in each row while monitoring is paused.
#: addon/globalPlugins/devStatusPanel/__init__.py:447
msgid "(paused)"
msgstr "（一時停止中）"

#. Translators: Note shown while monitoring is paused.
#: addon/globalPlugins/devStatusPanel/__init__.py:449
msgid "Note: Monitoring is paused. Enable monitoring to resume."
msgstr "※監視を停止しています。監視を有効にすると再開します。"

#. Translators: Category name in the Input Gestures dialog.
#: addon/globalPlugins/devStatusPanel/__init__.py:455
msgid "Developer Status Panel"
msgstr "開発者ステータスパネル"

#. Translators: Item in the NVDA Tools menu.
#: addon/globalPlugins/devStatusPanel/__init__.py:466
msgid "&Developer Status Panel"
msgstr "開発者ステータスパネル(&D)"

#. Translators: Description of the script shown in the Input Gestures dialog.
#: addon/globalPlugins/devStatusPanel/__init__.py:551
msgid "Shows or hides the Developer Status Panel"
msgstr "開発者ステータスパネルの表示／非表示を切り替えます"
